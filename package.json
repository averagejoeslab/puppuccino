{
  "name": "puppuccino",
  "version": "0.1.0",
  "private": true,
  "description": "AI coding agent for the terminal, featuring Kaldi the Great Pyrenees",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "puppuccino": "bun run apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "bun@1.1.0",
  "engines": {
    "node": ">=18"
  }
}
